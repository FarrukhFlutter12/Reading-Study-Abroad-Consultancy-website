# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# ---------------------------------------------------------------------------

# REQUIRED — free access key from https://web3forms.com
# Register with readingstudyabroad.pk@gmail.com so form submissions land in the
# office inbox. WITHOUT THIS, NO FORM ON THE SITE CAN SEND ANYTHING — every form
# shows a "not connected yet" message and asks the visitor to call or WhatsApp.
NEXT_PUBLIC_WEB3FORMS_KEY=

# OPTIONAL — free API key from https://www.pexels.com/api/
# Only used by `npm run images:fetch`, which downloads and optimises the site's
# photography. Never read at runtime and never sent to the browser. Without it
# every image slot renders the branded purple-gold panel instead.
PEXELS_API_KEY=

# NEXT_PUBLIC_* variables are inlined at BUILD time. After adding or changing
# one in Vercel you MUST redeploy — editing the variable alone does nothing to
# a build that has already shipped. Locally, restart the dev server.
