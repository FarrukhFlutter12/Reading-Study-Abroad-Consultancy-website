# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the value. Never commit .env.local.
# ---------------------------------------------------------------------------

# Free access key from https://web3forms.com
# Register with readingstudyabroad.pk@gmail.com so form submissions land in the
# office inbox. Without this, every form shows a "not connected yet" message and
# asks the visitor to call or WhatsApp instead.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Add the same variable in Vercel:
#   Project → Settings → Environment Variables → NEXT_PUBLIC_WEB3FORMS_KEY
#   Apply it to Production, Preview and Development, then redeploy.
